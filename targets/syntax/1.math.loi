# =========================================
# BASIC PRINT TESTS
# =========================================

print 10;
print 5;
print 3.14;

# =========================================
# SIMPLE MUTABLE ASSIGNMENT
# =========================================

x = 1;
x = 2;
x = 3;

print x;

# =========================================
# BASIC ARITHMETIC
# =========================================

x = 5 + 3;
y = 10 - 2;
z = 4 * 3;
w = 20 / 4;

print x;
print y;
print z;
print w;

# =========================================
# OPERATOR PRECEDENCE TESTS
# =========================================

x = 5 + 3 * 2;
y = (5 + 3) * 2;
z = 10 - 2 * 3 + 1;

print x;
print y;
print z;

# =========================================
# VARIABLE REUSE CHAINS
# =========================================

x = 10;
y = x + 2;
z = y + x;

print z;

# =========================================
# IMMUTABLE DECLARATION (=!)
# =========================================

x =! 10;
y = x + 5;

print y;

# =========================================
# DYNAMIC DECLARATION (=?)
# =========================================

x =? 5;
x = 10;

# NOTE:
# If your language does NOT support strings yet,
# the next line will FAIL until you implement string lexing + typing.

# x = "ignored in static typing but allowed in dynamic mode";

print x;

# =========================================
# COMBINED PROGRAM FLOW
# =========================================

x = 5 + 3;
y = x + 2;
z = y * 2;

print z;

print 10;

# =========================================
# STRESS TEST (MULTIPLE REASSIGNMENTS)
# =========================================

x = 1;
x = 2;
x = 3;

x = 5 + 3;
y =! x + 2;

print y;

x = 5 + 3;
y = x + 2;

print y;
