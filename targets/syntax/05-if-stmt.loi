print "starting"

fn add(a, b) {
    return a + b
}

if x > 5 {
    print "if"
} elif x == 5 {
    print "elif"
} else {
    print "else"
}

unless x < 0 {
    print "unless"
}

switch color {
    case "red" {
        print "red"
    }

    case "blue" {
        print "blue"
    }

    default {
        print "unknown"
    }
}

match value {
    1 => {
        print "one"
    }

    2 => {
        print "two"
    }

    _ => {
        print "other"
    }
}

pipe data {
    is String => {
        print "string"
    }

    length > 10 => {
        print "long"
    }

    contains("@") => {
        print "email-like"
    }
}

assert x > 0

try {
    throw "something bad"
} catch err {
    print err
} finally {
    print "cleanup"
}


generator = fn() {
    yield 1
    yield 2
    yield 3
}

next generator

a is b
a and b
a or b

return
