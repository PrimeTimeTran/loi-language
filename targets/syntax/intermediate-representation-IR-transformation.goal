# --- COMPILER INTERMEDIATE REPRESENTATION (IR) SPECIFICATION ---
# This IR uses Three-Address Code (TAC) format.
# Each instruction is of the form: result = op operand1, operand2

# 1. CONSTANT FOLDING & EXPRESSION BREAKDOWN
# High-level: z = (5 + 3) + (2 + 1)
# IR:
t1 = 8          ; (5+3) pre-calculated at compile-time
t2 = 3          ; (2+1) pre-calculated at compile-time
t3 = add t1, t2 ; (8+3)
z = mov t3

# 2. COPY PROPAGATION & FLATTENING
# High-level: x = 10; y = x
# IR:
x = mov 10
y = mov x       ; If x is immutable, optimizer might replace y = mov 10

# 3. COMMON SUBEXPRESSION ELIMINATION (CSE)
# High-level: y = x + 2; z = x + 2
# IR:
t1 = add x, 2
y = mov t1
z = mov t1      ; Reuse of t1 avoids recalculating the addition

# 4. CONTROL FLOW (BRANCHING)
# High-level: if x > 5 { print 1 }
# IR:
    cmp x, 5
    jle .L_END  ; Jump if less than or equal to label
    t1 = mov 1
    print t1
.L_END:

# 5. COMPLEX NESTED EXPRESSIONS
# High-level: a = (b * c) + (d / e)
# IR:
t1 = mul b, c
t2 = div d, e
a = add t1, t2

# 6. MEMORY ACCESS (LOAD/STORE)
# High-level: arr[0] = x
# IR:
t1 = mov 0      ; Offset
t2 = addr arr, t1
store [t2], x

# 7. FUNCTION CALLS
# High-level: print(y)
# IR:
push y
call print_func
pop
