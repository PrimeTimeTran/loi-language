# --- Basic Precedence ---
# 5 + (3 * 2)
5 + 3 * 2

# --- Nested Parentheses ---
# ((5 + 3) * 2)
(5 + 3) * 2

# --- Division and Multiplication ---
# (10 / 2) * 5
10 / 2 * 5

# --- Exponentiation (if implemented) or high-precedence unary ---
# (-5) + 3
-5 + 3

# --- Mixed Arithmetic with Grouping ---
# (10 + 20) / (5 * 2)
(10 + 20) / (5 * 2)

# --- Complex Nesting ---
# 1 + (2 * (3 + (4 / 2)))
1 + 2 * (3 + 4 / 2)

# --- Logical and Relational ---
# (x == 5) && (y > 10)
x == 5 && y > 10

# --- Multiple Operators (Left-to-Right Associativity) ---
# ((10 - 5) - 2)
10 - 5 - 2
