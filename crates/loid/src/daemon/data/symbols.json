{
  "symbols": [
    {
      "id": "loid.root",
      "type": "constant",
      "value": "~/.loid",
      "immutable": true,
      "doc": "Root directory of loid system state"
    },

    {
      "id": "loid.config",
      "type": "file",
      "path": "~/.loid/config.toml",
      "doc": "Global daemon configuration"
    },

    {
      "id": "loid.state",
      "type": "file",
      "path": "~/.loid/state.json",
      "doc": "Runtime state (starts, uptime, etc.)"
    },

    {
      "id": "loid.view.default",
      "type": "file",
      "path": "~/.loid/views/default.toml",
      "doc": "Default view definition"
    }
  ]
}
